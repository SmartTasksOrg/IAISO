# Binaries. Build them into bin/ (go build -o bin/ ./cmd/...). There is no "/iaiso" entry:
# it also matched the iaiso/ package directory, which kept the library out of git.
/bin/
/iaiso-conformance
/cmd/*/iaiso
/cmd/*/iaiso-conformance

# Go
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out
coverage.out

# IDEs
.idea/
.vscode/

# Go workspace
go.work
go.work.sum
