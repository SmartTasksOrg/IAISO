      "field": "tokens",
      "value": -9007199254740991,
      "class": "negative"
    },
    {
      "name": "tokens_fractional",
      "field": "tokens",
      "value": 1.5,
      "class": "non_integer"
    },
    {
      "name": "tokens_boolean_true",
      "field": "tokens",
      "value": true,
      "class": "non_integer"
    },
    {
      "name": "tokens_string_number",
      "field": "tokens",
      "value": "10",
      "class": "non_integer"
    },
    {
      "name": "tokens_null",
